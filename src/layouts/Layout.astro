---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'Nyaura SDA Church | A Community of Faith', description = 'Nyaura Seventh-day Adventist Church — worship, fellowship, and service. Join us every Sabbath for Bible study and divine worship.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/png" href="/sda-full-logo.png">
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest" defer></script>
</head>
<body>
  <slot />
</body>
</html>
