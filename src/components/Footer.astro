    </div>
  </div>
</footer>

<button class="scroll-top fixed bottom-6 right-6 w-12 h-12 rounded-full bg-navy text-gold flex items-center justify-center border-none cursor-pointer text-xl shadow-[0_8px_24px_rgba(0,0,0,0.2)] opacity-0 pointer-events-none transition-all duration-300 z-50 hover:bg-gold hover:text-navy-dark hover:-translate-y-0.5" id="scrollTop" aria-label="Scroll to top">↑</button>

<style is:global>
  .scroll-top.show { opacity: 1; pointer-events: auto; }
</style>
