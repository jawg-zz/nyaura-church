<footer class="bg-[#0a1628] text-white px-6 lg:px-12 pt-20 pb-10">
  <div class="max-w-[1400px] mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-12 lg:gap-10">
    <div>
      <a href="#" class="flex items-center gap-3 no-underline mb-4">
        <div class="h-14 flex items-center">
          <img src="/sda-full-logo.png" alt="Seventh-day Adventist Church" class="h-full w-auto object-contain brightness-0 invert">
        </div>
        <span class="font-heading text-[22px] font-semibold text-white">Nyaura</span>
      </a>
      <p class="text-white/60 text-sm leading-relaxed max-w-[320px]">A community of Seventh-day Adventist believers dedicated to sharing God's love and preparing for His return.</p>
      <div class="flex flex-col gap-3 mt-5 text-white/60 text-sm">
        <div class="flex gap-2.5 items-start"><span class="text-gold shrink-0 mt-0.5">📍</span><span>Nyaura, Kenya</span></div>
        <div class="flex gap-2.5 items-start"><span class="text-gold shrink-0 mt-0.5">📞</span><a href="tel:+254****0000" class="text-white/80 no-underline hover:text-white">+254 7XX XXX XXX</a></div>
        <div class="flex gap-2.5 items-start"><span class="text-gold shrink-0 mt-0.5">✉️</span><a href="mailto:info@nyaurachurch.org" class="text-white/80 no-underline hover:text-white">info@nyaurachurch.org</a></div>
      </div>
    </div>
    <div>
      <h4 class="font-body text-sm font-semibold tracking-[1px] uppercase text-gold mb-6">Worship</h4>
      <a href="#about" class="block text-white/60 no-underline text-sm mb-3 hover:text-white">Sabbath School</a>
      <a href="#about" class="block text-white/60 no-underline text-sm mb-3 hover:text-white">Divine Service</a>
      <a href="#about" class="block text-white/60 no-underline text-sm mb-3 hover:text-white">Prayer Meeting</a>
      <a href="#ministries" class="block text-white/60 no-underline text-sm mb-3 hover:text-white">Pathfinders</a>
