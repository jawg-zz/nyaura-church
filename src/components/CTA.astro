---
// CTA
---

<section class="px-6 lg:px-10 py-[100px] bg-navy text-center relative overflow-hidden">
  <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1504052434569-70ad5836ab65?w=1920&q=85')] bg-center bg-cover opacity-[0.06]"></div>
  <div class="relative z-10 max-w-[600px] mx-auto reveal">
    <div class="section-label justify-center">
      <span class="line" style="background: var(--color-gold);"></span>
      <span style="color: var(--color-gold-light);">Join Us</span>
      <span class="line" style="background: var(--color-gold);"></span>
    </div>
    <h2 class="text-[clamp(32px,3.5vw,48px)] text-white mb-4">Visit us this Sabbath</h2>
    <p class="text-white/55 text-base mb-10 leading-relaxed">Experience the warmth of Christian fellowship and discover a spiritual home where everyone belongs. We can't wait to welcome you.</p>
    <div class="flex gap-4 justify-center flex-wrap">
      <a href="#visit" class="btn-gold">Plan Your Visit →</a>
      <a href="#prayer" class="btn-outline-light">Submit Prayer Request</a>
    </div>
  </div>
</section>
