---
// CTA section
---

<section class="px-6 lg:px-12 py-[120px] bg-gradient-to-br from-navy to-navy-dark text-center relative overflow-hidden">
  <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1504052434569-70ad5836ab65?w=1920&q=80')] bg-center bg-cover opacity-10"></div>
  <div class="relative z-10 max-w-[800px] mx-auto reveal">
    <span class="inline-block text-gold-light text-[13px] font-semibold tracking-[2px] uppercase mb-4">Join Us</span>
    <h2 class="text-[clamp(36px,4vw,52px)] text-white mb-4">Visit us this Sabbath</h2>
    <p class="text-white/80 text-lg mb-10">Experience the warmth of Christian fellowship and discover a spiritual home where everyone belongs. We can't wait to welcome you.</p>
    <div class="flex gap-4 justify-center flex-wrap">
      <a href="#visit" class="btn-gold inline-flex items-center gap-2 px-10 py-[18px] rounded-lg font-medium text-base no-underline transition-all duration-300">Plan Your Visit →</a>
      <a href="#prayer" class="btn-outline inline-flex items-center gap-2 px-8 py-[18px] rounded-lg font-medium text-base no-underline transition-all duration-300">Submit Prayer Request</a>
    </div>
  </div>
</section>
