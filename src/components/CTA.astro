---
// CTA
---

<section class="px-6 lg:px-12 py-24 lg:py-32 bg-navy text-center relative overflow-hidden">
  <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1504052434569-70ad5836ab65?w=1920&q=85')] bg-center bg-cover opacity-[0.06]"></div>
  <div class="relative z-10 max-w-[650px] mx-auto reveal">
    <div class="flex items-center justify-center gap-3 mb-6">
      <span class="inline-block w-8 h-px bg-gold"></span>
      <span class="section-badge" style="color: var(--color-gold-light);">Join Us</span>
      <span class="inline-block w-8 h-px bg-gold"></span>
    </div>
    <h2 class="text-[clamp(32px,3.5vw,48px)] text-white mb-4">Visit us this Sabbath</h2>
    <p class="text-white/60 text-base mb-10 leading-relaxed">Experience the warmth of Christian fellowship and discover a spiritual home where everyone belongs. We can't wait to welcome you.</p>
    <div class="flex gap-4 justify-center flex-wrap">
      <a href="#visit" class="btn btn-gold text-sm">Plan Your Visit →</a>
      <a href="#prayer" class="btn btn-outline text-white/70 border-white/20 text-sm hover:bg-white/8 hover:border-white/35">Submit Prayer Request</a>
    </div>
  </div>
</section>
