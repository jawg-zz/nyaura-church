---
import { beliefs } from '../data/church.js';
---

<section id="beliefs" class="px-6 lg:px-12 py-24 lg:py-32 bg-surface">
  <div class="max-w-[1400px] mx-auto">
    <div class="max-w-[680px] mb-16 reveal">
      <div class="flex items-center gap-3 mb-6">
        <span class="inline-block w-8 h-px bg-gold"></span>
        <span class="section-badge">What We Believe</span>
      </div>
      <h2 class="text-[clamp(32px,3.5vw,48px)] mb-4">28 Fundamental Beliefs</h2>
      <p class="text-text-secondary text-[16px] leading-relaxed">As Seventh-day Adventists, our faith is grounded in Scripture and centered on the hope of Christ's return. Explore the core beliefs that guide our walk with God.</p>
    </div>

    <div class="flex gap-2 mb-12 flex-wrap reveal" id="beliefTabs">
      {['All', 'God & Scripture', 'Salvation', 'Church & Life', 'Last Things'].map((label, i) => (
        <button class={`belief-tab ${i === 0 ? 'active' : ''} px-4 py-2 bg-white border border-border rounded-full text-sm font-medium text-text-secondary cursor-pointer transition-all duration-200 font-body hover:border-gold`} data-category={['all', 'god', 'salvation', 'church', 'end'][i]}>
          {label}
        </button>
      ))}
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5" id="beliefsGrid">
      {beliefs.map(b => (
        <div class="bg-white rounded-xl p-6 border border-border/50 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_12px_28px_rgba(0,0,0,0.06)]" data-category={b.c}>
          <div class="font-heading text-xs text-gold font-semibold tracking-[1px] mb-1">#{String(b.n).padStart(2, '0')}</div>
          <h4 class="text-base text-navy mb-2 leading-snug">{b.t}</h4>
          <p class="text-sm text-text-secondary leading-relaxed">{b.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .belief-tab.active { background: var(--color-navy); color: white; border-color: var(--color-navy); }
  .belief-tab:hover:not(.active) { background: var(--color-surface); }
</style>
