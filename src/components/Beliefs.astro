---
import { beliefs } from '../data/church.js';
---

<section id="beliefs" class="px-6 lg:px-12 py-[120px] bg-cream">
  <div class="max-w-[1400px] mx-auto">
    <div class="text-center max-w-[700px] mx-auto mb-16 reveal">
      <span class="inline-block text-gold text-[13px] font-semibold tracking-[2px] uppercase mb-4">What We Believe</span>
      <h2 class="text-[clamp(36px,4vw,52px)] text-navy mb-4">28 Fundamental Beliefs</h2>
      <p class="text-text-light text-lg">As Seventh-day Adventists, our faith is grounded in Scripture and centered on the hope of Christ's return. Explore the core beliefs that guide our walk with God.</p>
    </div>

    <!-- Tabs -->
    <div class="flex justify-center gap-2 mb-12 flex-wrap reveal" id="beliefTabs">
      <button class="belief-tab active px-5 py-2.5 bg-white border border-black/8 rounded-full text-sm font-medium text-text cursor-pointer transition-all duration-200 font-body" data-category="all">All</button>
      <button class="belief-tab px-5 py-2.5 bg-white border border-black/8 rounded-full text-sm font-medium text-text cursor-pointer transition-all duration-200 font-body" data-category="god">God & Scripture</button>
      <button class="belief-tab px-5 py-2.5 bg-white border border-black/8 rounded-full text-sm font-medium text-text cursor-pointer transition-all duration-200 font-body" data-category="salvation">Salvation</button>
      <button class="belief-tab px-5 py-2.5 bg-white border border-black/8 rounded-full text-sm font-medium text-text cursor-pointer transition-all duration-200 font-body" data-category="church">Church & Life</button>
      <button class="belief-tab px-5 py-2.5 bg-white border border-black/8 rounded-full text-sm font-medium text-text cursor-pointer transition-all duration-200 font-body" data-category="end">Last Things</button>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5" id="beliefsGrid">
      {
        beliefs.map(b => (
          <div class="belief-card bg-white rounded-2xl p-7 border border-black/4 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgba(0,0,0,0.08)]" data-category={b.c}>
            <div class="font-heading text-sm text-gold font-semibold tracking-[1px] mb-3">№ {b.n}</div>
            <h4 class="text-lg text-navy mb-2 leading-tight">{b.t}</h4>
            <p class="text-sm text-text-light leading-relaxed">{b.d}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .belief-tab.active { background: var(--color-navy); color: white; border-color: var(--color-navy); }
  .belief-tab:hover:not(.active) { background: var(--color-navy); color: white; border-color: var(--color-navy); }
</style>
