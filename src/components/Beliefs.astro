---
import { beliefs } from '../data/church.js';
---

<section id="beliefs" class="px-6 lg:px-10 py-[100px] bg-white">
  <div class="max-w-[1200px] mx-auto">
    <div class="reveal">
      <div class="section-label">
        <span class="line"></span>
        <span>What We Believe</span>
      </div>
      <h2 class="text-[clamp(32px,3vw,44px)] mb-2">28 Fundamental Beliefs</h2>
      <p class="text-ink-secondary text-[17px] leading-relaxed max-w-[640px] mb-10">As Seventh-day Adventists, our faith is grounded in Scripture and centered on the hope of Christ's return.</p>
    </div>

    <div class="flex gap-1 mb-12 flex-wrap reveal" id="beliefTabs">
      {['All', 'God & Scripture', 'Salvation', 'Church & Life', 'Last Things'].map((label, i) => (
        <button class={`belief-tab ${i === 0 ? 'active' : ''} px-5 py-2.5 bg-cream border-none rounded-md text-sm font-medium text-ink-secondary cursor-pointer font-body transition-all duration-200`}
          data-category={['all', 'god', 'salvation', 'church', 'end'][i]}>{label}</button>
      ))}
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5" id="beliefsGrid">
      {beliefs.map(b => (
        <div class="bg-cream rounded-sm p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgba(0,0,0,0.06)]" data-category={b.c}>
          <div class="font-body text-xs font-semibold text-gold tracking-[2px] uppercase mb-3">#{String(b.n).padStart(2,'0')}</div>
          <h4 class="font-heading text-xl text-navy mb-2 font-normal leading-snug">{b.t}</h4>
          <p class="text-sm text-ink-secondary leading-relaxed">{b.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .belief-tab.active { background: var(--color-navy); color: white; }
  .belief-tab:hover:not(.active) { background: var(--color-navy); color: white; }
</style>
