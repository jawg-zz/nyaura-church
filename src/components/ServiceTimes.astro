---
// Service times — border-grid style
---

<div class="bg-white px-6 lg:px-10 py-[70px]">
  <div class="max-w-[1200px] mx-auto">
    <div class="section-label">
      <span class="line"></span>
      <span>Service Times</span>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 border border-border">
      {[
        { icon: 'book-open', title: 'Sabbath School', desc: 'Bible study for all ages', time: 'Saturday 9:30 AM' },
        { icon: 'church', title: 'Divine Worship', desc: 'Main worship service', time: 'Saturday 11:00 AM' },
        { icon: 'heart', title: 'Prayer Meeting', desc: 'Midweek fellowship', time: 'Wednesday 7:00 PM' },
        { icon: 'sun', title: 'Pathfinders', desc: 'Youth ministry program', time: 'Friday 5:00 PM' },
      ].map(s => (
        <div class="bg-white py-9 px-8 text-center border-r border-b border-border last:border-r-0">
          <div class="w-[44px] h-[44px] mx-auto mb-4 bg-cream rounded-md flex items-center justify-center text-navy">
            <i data-lucide={s.icon} class="w-5 h-5"></i>
          </div>
          <h4 class="font-body text-base font-semibold text-navy mb-1">{s.title}</h4>
          <p class="text-sm text-ink-muted">{s.desc}</p>
          <p class="text-[13px] font-semibold text-gold mt-3 tracking-[0.5px]">{s.time}</p>
        </div>
      ))}
    </div>
  </div>
</div>
