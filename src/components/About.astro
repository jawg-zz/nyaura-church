---
// About section
---

<section id="about" class="px-6 lg:px-12 py-24 lg:py-32 bg-white">
  <div class="max-w-[1400px] mx-auto grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">
    <div class="relative">
      <div class="relative z-10 overflow-hidden rounded-xl">
        <img src="https://images.unsplash.com/photo-1504052434569-70ad5836ab65?w=900&q=85" alt="Church building" class="w-full h-[480px] lg:h-[560px] object-cover">
      </div>
      <div class="absolute -bottom-6 -right-6 w-[55%] h-[55%] overflow-hidden rounded-xl border-[6px] border-white shadow-[0_16px_40px_rgba(0,0,0,0.1)]">
        <img src="https://images.unsplash.com/photo-1438032005730-c779502df39b?w=600&q=85" alt="Community gathering" class="w-full h-full object-cover">
      </div>
    </div>
    <div class="reveal">
      <div class="flex items-center gap-3 mb-6">
        <span class="inline-block w-8 h-px bg-gold"></span>
        <span class="section-badge">About Our Church</span>
      </div>
      <h2 class="text-[clamp(32px,3.5vw,48px)] text-navy mb-6 leading-[1.1]">A family of believers rooted in faith</h2>
      <div class="space-y-4 text-text-secondary text-[16px] leading-relaxed max-w-[540px]">
        <p>Nyaura SDA Church is a vibrant Seventh-day Adventist congregation committed to worshiping God in spirit and truth. For over 25 years, we've been a beacon of hope in our community.</p>
        <p>We believe in the transformative power of faith, the importance of community, and the hope found in God's Word. Our doors are open to all who seek spiritual growth and meaningful fellowship.</p>
      </div>
      <div class="grid grid-cols-3 gap-10 mt-12 pt-10 border-t border-border">
        {[
          { num: '500+', label: 'Active Members' },
          { num: '25+', label: 'Years of Ministry' },
          { num: '15+', label: 'Active Ministries' },
        ].map(stat => (
          <div>
            <h3 class="text-[40px] font-semibold text-navy font-heading tracking-tight">{stat.num}</h3>
            <p class="text-sm text-text-muted mt-1">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
