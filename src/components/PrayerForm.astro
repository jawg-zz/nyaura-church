---
// Prayer Form
---

<section id="prayer" class="px-6 lg:px-12 py-24 lg:py-32 bg-white">
  <div class="max-w-[800px] mx-auto">
    <div class="max-w-[600px] mx-auto text-center mb-14 reveal">
      <div class="flex items-center justify-center gap-3 mb-6">
        <span class="inline-block w-8 h-px bg-gold"></span>
        <span class="section-badge">We Pray With You</span>
        <span class="inline-block w-8 h-px bg-gold"></span>
      </div>
      <h2 class="text-[clamp(28px,3vw,40px)] mb-4">Submit a Prayer Request</h2>
      <p class="text-text-secondary text-[16px] leading-relaxed">Share your prayer needs with us. Our prayer team will lift you up in prayer.</p>
    </div>
    <form class="bg-surface rounded-xl p-8 lg:p-10 border border-border/50 reveal" id="prayerForm" action="https://formsubmit.co/pastor@nyaurachurch.org" method="POST">
      <input type="hidden" name="_subject" value="New Prayer Request — Nyaura Church">
      <input type="hidden" name="_captcha" value="false">
      <input type="hidden" name="_template" value="box">
      <div class="grid md:grid-cols-2 gap-4 mb-4">
        <div class="flex flex-col gap-1.5">
          <label for="pName" class="text-xs font-semibold text-navy uppercase tracking-[0.5px]">Your Name</label>
          <input type="text" id="pName" name="name" required placeholder="Full name" class="px-4 py-3 border border-border rounded-lg text-sm font-body text-text bg-white transition-all duration-200 focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/10">
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="pEmail" class="text-xs font-semibold text-navy uppercase tracking-[0.5px]">Email (optional)</label>
          <input type="email" id="pEmail" name="email" placeholder="you@example.com" class="px-4 py-3 border border-border rounded-lg text-sm font-body text-text bg-white transition-all duration-200 focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/10">
        </div>
      </div>
      <div class="mb-4">
        <div class="flex flex-col gap-1.5">
          <label for="pCategory" class="text-xs font-semibold text-navy uppercase tracking-[0.5px]">Category</label>
          <select id="pCategory" name="category" class="px-4 py-3 border border-border rounded-lg text-sm font-body text-text bg-white transition-all duration-200 focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/10">
            {['Personal', 'Family', 'Health', 'Finances', 'Work / Career', 'Spiritual Growth', 'Thanksgiving', 'Other'].map(c => <option>{c}</option>)}
          </select>
        </div>
      </div>
      <div class="mb-4">
        <div class="flex flex-col gap-1.5">
          <label for="pRequest" class="text-xs font-semibold text-navy uppercase tracking-[0.5px]">Your Prayer Request</label>
          <textarea id="pRequest" name="request" required placeholder="Share what's on your heart..." class="px-4 py-3 border border-border rounded-lg text-sm font-body text-text bg-white transition-all duration-200 focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/10 resize-y min-h-[120px]"></textarea>
        </div>
      </div>
      <label class="flex items-start gap-2.5 mb-6 text-xs text-text-secondary cursor-pointer">
        <input type="checkbox" name="private" value="yes" class="mt-0.5 accent-gold">
        <span>Keep this request confidential (shared only with the pastor & prayer team)</span>
      </label>
      <button type="submit" class="btn btn-primary w-full justify-center text-sm">Submit Prayer Request</button>
      <div class="hidden p-4 bg-green-50 border border-green-200 rounded-lg text-success text-sm mt-4" id="formSuccess">
        ✓ Thank you. Your prayer request has been received. We will be praying for you.
      </div>
    </form>
  </div>
</section>
