---
// Prayer Request section
---

<section id="prayer" class="px-6 lg:px-12 py-[120px] bg-cream">
  <div class="max-w-[900px] mx-auto">
    <div class="text-center max-w-[700px] mx-auto mb-16 reveal">
      <span class="inline-block text-gold text-[13px] font-semibold tracking-[2px] uppercase mb-4">We Pray With You</span>
      <h2 class="text-[clamp(36px,4vw,52px)] text-navy mb-4">Submit a Prayer Request</h2>
      <p class="text-text-light text-lg">Share your prayer needs with us. Our prayer team will lift you up in prayer.</p>
    </div>
    <form class="bg-white p-8 lg:p-12 rounded-2xl shadow-[0_20px_60px_rgba(0,0,0,0.06)] reveal" id="prayerForm" action="https://formsubmit.co/pastor@nyaurachurch.org" method="POST">
      <input type="hidden" name="_subject" value="New Prayer Request — Nyaura Church">
      <input type="hidden" name="_captcha" value="false">
      <input type="hidden" name="_template" value="box">
      <div class="grid md:grid-cols-2 gap-5 mb-5">
        <div class="flex flex-col">
          <label for="pName" class="text-[13px] font-semibold text-navy mb-2 uppercase tracking-[0.5px]">Your Name</label>
          <input type="text" id="pName" name="name" required placeholder="Full name" class="px-4 py-3.5 border border-black/10 rounded-xl text-[15px] font-body text-text bg-white transition-all duration-200 focus:outline-none focus:border-gold focus:shadow-[0_0_0_3px_rgba(201,169,98,0.15)]">
        </div>
        <div class="flex flex-col">
          <label for="pEmail" class="text-[13px] font-semibold text-navy mb-2 uppercase tracking-[0.5px]">Email (optional)</label>
          <input type="email" id="pEmail" name="email" placeholder="you@example.com" class="px-4 py-3.5 border border-black/10 rounded-xl text-[15px] font-body text-text bg-white transition-all duration-200 focus:outline-none focus:border-gold focus:shadow-[0_0_0_3px_rgba(201,169,98,0.15)]">
        </div>
      </div>
      <div class="mb-5">
        <div class="flex flex-col">
          <label for="pCategory" class="text-[13px] font-semibold text-navy mb-2 uppercase tracking-[0.5px]">Category</label>
          <select id="pCategory" name="category" class="px-4 py-3.5 border border-black/10 rounded-xl text-[15px] font-body text-text bg-white transition-all duration-200 focus:outline-none focus:border-gold focus:shadow-[0_0_0_3px_rgba(201,169,98,0.15)]">
            <option>Personal</option>
            <option>Family</option>
            <option>Health</option>
            <option>Finances</option>
            <option>Work / Career</option>
            <option>Spiritual Growth</option>
            <option>Thanksgiving</option>
            <option>Other</option>
          </select>
        </div>
      </div>
      <div class="mb-5">
        <div class="flex flex-col">
          <label for="pRequest" class="text-[13px] font-semibold text-navy mb-2 uppercase tracking-[0.5px]">Your Prayer Request</label>
          <textarea id="pRequest" name="request" required placeholder="Share what's on your heart..." class="px-4 py-3.5 border border-black/10 rounded-xl text-[15px] font-body text-text bg-white transition-all duration-200 focus:outline-none focus:border-gold focus:shadow-[0_0_0_3px_rgba(201,169,98,0.15)] resize-y min-h-[120px]"></textarea>
        </div>
      </div>
      <label class="flex items-start gap-2.5 my-6 text-[13px] text-text-light">
        <input type="checkbox" name="private" value="yes" class="mt-1">
        <span>Keep this request confidential (shared only with the pastor & prayer team)</span>
      </label>
      <button type="submit" class="btn-navy w-full justify-center inline-flex items-center gap-2 px-8 py-4 rounded-lg font-medium text-sm no-underline border-none cursor-pointer font-body transition-all duration-300">🙏 Submit Prayer Request</button>
      <div class="hidden p-4 bg-green-50 border border-green-300 rounded-xl text-success text-sm mt-4" id="formSuccess">
        ✓ Thank you. Your prayer request has been received. We will be praying for you.
      </div>
    </form>
  </div>
</section>
