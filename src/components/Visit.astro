---
// Plan Your Visit section
---

<section id="visit" class="px-6 lg:px-12 py-[120px] bg-white">
  <div class="max-w-[1400px] mx-auto grid lg:grid-cols-[1fr_1.2fr] gap-20 items-stretch">
    <div class="flex flex-col reveal">
      <span class="inline-block text-gold text-[13px] font-semibold tracking-[2px] uppercase mb-4">First Time?</span>
      <h2 class="text-[clamp(36px,4vw,48px)] text-navy mb-4">Plan Your Visit</h2>
      <p class="text-text-light text-[17px] leading-relaxed mb-8">We'd love to welcome you. Here's what to expect when you visit Nyaura SDA Church.</p>
      <div class="grid gap-5 mb-8">
        {[
          { icon: '👋', title: 'Warm Welcome', desc: 'Our greeters will meet you at the door. No dress code — come as you are.' },
          { icon: '👶', title: 'Children Welcome', desc: 'Sabbath School classes for all ages, plus a nursery for little ones.' },
          { icon: '☕', title: 'Fellowship Meal', desc: 'Stay after service for fellowship lunch — a beloved church tradition.' },
          { icon: '🅿️', title: 'Easy Access', desc: 'Ample parking, wheelchair accessible, and clear signage throughout.' },
        ].map(v => (
          <div class="flex gap-4 p-5 bg-cream rounded-xl">
            <div class="w-11 h-11 bg-navy text-gold rounded-xl flex items-center justify-center text-xl shrink-0">{v.icon}</div>
            <div>
              <h4 class="text-base text-navy mb-1 font-body font-semibold">{v.title}</h4>
              <p class="text-sm text-text-light leading-relaxed">{v.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="bg-cream rounded-2xl overflow-hidden min-h-[480px] reveal">
      <iframe
        src="https://www.openstreetmap.org/export/embed.html?bbox=36.78%2C-1.30%2C36.86%2C-1.24&layer=mapnik&marker=-1.27%2C36.82"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Nyaura SDA Church Location"
        class="w-full h-full border-0 min-h-[480px]"></iframe>
    </div>
  </div>
</section>
