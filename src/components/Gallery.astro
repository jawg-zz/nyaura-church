---
// Gallery
---

<section id="gallery" class="px-6 lg:px-12 py-24 lg:py-32 bg-white">
  <div class="max-w-[1400px] mx-auto">
    <div class="max-w-[680px] mb-16 reveal">
      <div class="flex items-center gap-3 mb-6">
        <span class="inline-block w-8 h-px bg-gold"></span>
        <span class="section-badge">Memories Together</span>
      </div>
      <h2 class="text-[clamp(32px,3.5vw,48px)] mb-4">Life at Nyaura</h2>
      <p class="text-text-secondary text-[16px] leading-relaxed">Moments from worship, fellowship, and service — captured through the year.</p>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 auto-rows-[180px] lg:auto-rows-[240px]" id="galleryGrid">
      {[
        { src: 'https://images.unsplash.com/photo-1438032005730-c779502df39b?w=800&q=85', full: 'https://images.unsplash.com/photo-1438032005730-c779502df39b?w=1600&q=85', alt: 'Worship', cls: 'lg:col-span-2' },
        { src: 'https://images.unsplash.com/photo-1504052434569-70ad5836ab65?w=600&q=85', full: 'https://images.unsplash.com/photo-1504052434569-70ad5836ab65?w=1200&q=85', alt: 'Church building', cls: 'lg:row-span-2' },
        { src: 'https://images.unsplash.com/photo-1511632765486-a01980e01a18?w=600&q=85', full: 'https://images.unsplash.com/photo-1511632765486-a01980e01a18?w=800&q=85', alt: 'Fellowship', cls: '' },
        { src: 'https://images.unsplash.com/photo-1529070538774-1843cb3265df?w=600&q=85', full: 'https://images.unsplash.com/photo-1529070538774-1843cb3265df?w=1200&q=85', alt: 'Community', cls: 'lg:row-span-2' },
        { src: 'https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=800&q=85', full: 'https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=1600&q=85', alt: 'Youth', cls: 'lg:col-span-2' },
        { src: 'https://images.unsplash.com/photo-1545987796-200677ee1011?w=600&q=85', full: 'https://images.unsplash.com/photo-1545987796-200677ee1011?w=800&q=85', alt: 'Music', cls: '' },
        { src: 'https://images.unsplash.com/photo-1473445730015-841f29a9490b?w=600&q=85', full: 'https://images.unsplash.com/photo-1473445730015-841f29a9490b?w=800&q=85', alt: 'Baptism', cls: '' },
      ].map(g => (
        <div class={`rounded-lg overflow-hidden relative cursor-pointer bg-navy-dark gallery-item ${g.cls}`} data-img={g.full}>
          <img src={g.src} alt={g.alt} loading="lazy" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105">
        </div>
      ))}
    </div>
  </div>
</section>

<div class="lightbox fixed inset-0 bg-black/90 z-[2000] hidden items-center justify-center p-6" id="lightbox">
  <button class="absolute top-5 right-5 bg-white/8 border-none text-white w-10 h-10 rounded-full cursor-pointer flex items-center justify-center hover:bg-white/15 transition-colors duration-200 backdrop-blur-sm" id="lightboxClose">
    <i data-lucide="x" class="w-5 h-5"></i>
  </button>
  <img id="lightboxImg" src="" alt="" class="max-w-[90%] max-h-[90vh] rounded-lg shadow-2xl">
</div>

<style is:global>
  .gallery-item::after {
    content: '';
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.3);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .gallery-item:hover::after { opacity: 1; background: rgba(0,0,0,0.4); }
  .gallery-item:hover::after { content: ''; }
  .gallery-item:hover .gallery-icon { opacity: 1; }
  .lightbox.open { display: flex; }
</style>
