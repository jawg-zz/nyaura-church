---
// Ministries — border-grid
---

<section id="ministries" class="px-6 lg:px-10 py-[100px] bg-cream">
  <div class="max-w-[1200px] mx-auto">
    <div class="max-w-[680px] mb-14 reveal">
      <div class="section-label">
        <span class="line"></span>
        <span>Our Ministries</span>
      </div>
      <h2 class="text-[clamp(32px,3vw,44px)] mb-2">Serving together in love</h2>
      <p class="text-ink-secondary text-[17px] leading-relaxed">Discover the many ways you can grow spiritually and serve our community through our diverse ministries.</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 border border-border">
      {[
        { icon: 'book-open', title: 'Bible Study', desc: "Deepen your understanding of God's Word through interactive study groups and personal devotion resources." },
        { icon: 'music', title: 'Music Ministry', desc: "Share God's love through song with our choir, praise team, and special music programs for all ages." },
        { icon: 'users', title: 'Family Ministry', desc: 'Strengthen family bonds through marriage enrichment, parenting workshops, and family-focused events.' },
        { icon: 'heart-pulse', title: 'Health Ministry', desc: 'Promote whole-person wellness through health seminars, cooking classes, and community health programs.' },
        { icon: 'globe', title: 'Missions', desc: "Share God's love locally and globally through outreach programs, community service, and mission trips." },
        { icon: 'sparkles', title: 'Youth Ministry', desc: 'Empower the next generation through Pathfinders, youth groups, and mentorship programs.' },
      ].map(m => (
        <div class="bg-white py-10 px-9 border-r border-b border-border transition-all duration-300 hover:bg-cream">
          <div class="w-[44px] h-[44px] mb-5 bg-cream rounded-md flex items-center justify-center text-navy">
            <i data-lucide={m.icon} class="w-5 h-5"></i>
          </div>
          <h3 class="font-heading text-[24px] text-navy font-normal mb-3">{m.title}</h3>
          <p class="text-sm text-ink-secondary leading-relaxed">{m.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
