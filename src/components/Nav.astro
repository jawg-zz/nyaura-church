---
// Navigation bar — fixed, frosted glass
---

<nav id="mainNav" class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-xl border-b border-black/8 px-6 lg:px-12 transition-shadow duration-300">
  <div class="max-w-[1400px] mx-auto flex items-center justify-between h-20">
    <a href="#" class="flex items-center gap-3 no-underline">
      <div class="h-14 flex items-center">
        <img src="/sda-full-logo.png" alt="Seventh-day Adventist Church" class="h-full w-auto object-contain">
      </div>
      <span class="font-heading text-[22px] font-semibold text-navy">Nyaura</span>
    </a>
    <ul class="hidden lg:flex items-center gap-8 list-none">
      <li><a href="#about" class="nav-link text-sm font-medium text-text no-underline transition-colors duration-200 hover:text-gold">About</a></li>
      <li><a href="#beliefs" class="nav-link text-sm font-medium text-text no-underline transition-colors duration-200 hover:text-gold">Beliefs</a></li>
      <li><a href="#sermons" class="nav-link text-sm font-medium text-text no-underline transition-colors duration-200 hover:text-gold">Sermons</a></li>
      <li><a href="#ministries" class="nav-link text-sm font-medium text-text no-underline transition-colors duration-200 hover:text-gold">Ministries</a></li>
      <li><a href="#events" class="nav-link text-sm font-medium text-text no-underline transition-colors duration-200 hover:text-gold">Events</a></li>
      <li><a href="#visit" class="nav-link text-sm font-medium text-text no-underline transition-colors duration-200 hover:text-gold">Visit</a></li>
      <li><a href="#contact" class="!bg-navy text-white px-6 py-3 rounded-lg font-medium no-underline transition-all duration-200 hover:!bg-navy-dark hover:-translate-y-0.5">Give</a></li>
    </ul>
    <button class="hamburger lg:hidden bg-none border-none cursor-pointer w-10 h-10 flex flex-col justify-center gap-[5px]" id="hamburger" aria-label="Menu">
      <span class="block w-6 h-0.5 bg-navy rounded-sm transition-all duration-300"></span>
      <span class="block w-6 h-0.5 bg-navy rounded-sm transition-all duration-300"></span>
      <span class="block w-6 h-0.5 bg-navy rounded-sm transition-all duration-300"></span>
    </button>
  </div>
</nav>

<div class="mobile-menu fixed top-20 left-0 right-0 bottom-0 bg-white p-8 flex-col gap-2 z-40 overflow-y-auto hidden" id="mobileMenu">
  <a href="#about" class="mobile-link py-4 text-text no-underline text-[17px] font-medium border-b border-black/6">About</a>
  <a href="#beliefs" class="mobile-link py-4 text-text no-underline text-[17px] font-medium border-b border-black/6">Beliefs</a>
  <a href="#sermons" class="mobile-link py-4 text-text no-underline text-[17px] font-medium border-b border-black/6">Sermons</a>
  <a href="#ministries" class="mobile-link py-4 text-text no-underline text-[17px] font-medium border-b border-black/6">Ministries</a>
  <a href="#events" class="mobile-link py-4 text-text no-underline text-[17px] font-medium border-b border-black/6">Events</a>
  <a href="#gallery" class="mobile-link py-4 text-text no-underline text-[17px] font-medium border-b border-black/6">Gallery</a>
  <a href="#visit" class="mobile-link py-4 text-text no-underline text-[17px] font-medium border-b border-black/6">Plan Your Visit</a>
  <a href="#prayer" class="mobile-link py-4 text-text no-underline text-[17px] font-medium border-b border-black/6">Prayer Request</a>
  <a href="#contact" class="mobile-link py-4 text-text no-underline text-[17px] font-medium border-b border-black/6">Give</a>
</div>

<style is:global>
  nav.scrolled { box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    background: var(--color-gold);
  }
  .nav-link.active { color: var(--color-gold); }
  .nav-link { position: relative; }
  .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .mobile-menu.open { display: flex; }
</style>
