---
// Nav
---

<nav id="mainNav" class="fixed top-0 left-0 right-0 z-50 bg-cream/92 backdrop-blur-lg border-b border-border-light transition-shadow duration-300 px-6 lg:px-10">
  <div class="max-w-[1200px] mx-auto flex items-center justify-between h-[72px]">
    <a href="#" class="flex items-center gap-3 no-underline group">
      <div class="h-[44px] flex items-center">
        <img src="/sda-full-logo.png" alt="Seventh-day Adventist Church" class="h-full w-auto object-contain">
      </div>
      <span class="font-heading text-[22px] text-navy">Nyaura</span>
    </a>

    <ul class="hidden lg:flex items-center gap-1 list-none">
      {['About', 'Beliefs', 'Sermons', 'Ministries', 'Events', 'Visit'].map(item => (
        <li>
          <a href={'#' + item.toLowerCase()} class="nav-link px-[18px] py-2 text-[15px] font-medium text-ink-secondary no-underline rounded-md transition-all duration-200 hover:text-navy hover:bg-navy/4">
            {item}
          </a>
        </li>
      ))}
      <li class="ml-2">
        <a href="#contact" class="bg-navy text-white no-underline px-[22px] py-2.5 rounded-md font-semibold text-[14px] tracking-[0.3px] transition-all duration-200 hover:bg-navy-light hover:-translate-y-px">
          Give
        </a>
      </li>
    </ul>

    <button class="hamburger lg:hidden bg-none border-none cursor-pointer w-10 h-10 flex flex-col justify-center gap-[5px]" id="hamburger" aria-label="Menu">
      <span class="block w-6 h-px bg-navy rounded transition-all duration-300"></span>
      <span class="block w-6 h-px bg-navy rounded transition-all duration-300"></span>
      <span class="block w-6 h-px bg-navy rounded transition-all duration-300"></span>
    </button>
  </div>
</nav>

<div class="hidden fixed top-[72px] left-0 right-0 bottom-0 bg-cream/98 backdrop-blur-lg p-8 z-40 overflow-y-auto" id="mobileMenu">
  <div class="flex flex-col gap-1">
    {['About', 'Beliefs', 'Sermons', 'Ministries', 'Events', 'Gallery', 'Visit', 'Prayer', 'Give'].map(item => (
      <a href={'#' + (item === 'Prayer' ? 'prayer' : item === 'Give' ? 'contact' : item.toLowerCase())} class="mobile-link py-3.5 px-4 text-ink-secondary no-underline text-[16px] font-medium rounded-lg hover:bg-navy/4 transition-colors duration-200">
        {item}
      </a>
    ))}
  </div>
</div>

<style is:global>
  nav.scrolled { box-shadow: 0 4px 24px rgba(0,0,0,0.04); }
  .nav-link.active { color: var(--color-navy); background: rgba(26,42,58,0.04); }
</style>
