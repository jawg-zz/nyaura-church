---
// Navigation
---

<nav id="mainNav" class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-lg border-b border-border/50 px-6 lg:px-12 transition-shadow duration-300">
  <div class="max-w-[1400px] mx-auto flex items-center justify-between h-[72px] lg:h-20">
    <a href="#" class="flex items-center gap-3 no-underline group">
      <div class="h-12 lg:h-14 flex items-center">
        <img src="/sda-full-logo.png" alt="Seventh-day Adventist Church" class="h-full w-auto object-contain">
      </div>
      <span class="font-heading text-xl lg:text-[22px] font-semibold text-navy">Nyaura</span>
    </a>

    <ul class="hidden lg:flex items-center gap-1 list-none">
      {['About', 'Beliefs', 'Sermons', 'Ministries', 'Events', 'Visit'].map(item => (
        <li>
          <a href={'#' + item.toLowerCase()} class="nav-link px-4 py-2 text-sm font-medium text-text-secondary no-underline rounded-md transition-all duration-200 hover:text-navy hover:bg-surface">
            {item}
          </a>
        </li>
      ))}
      <li class="ml-3">
        <a href="#contact" class="btn btn-primary btn-sm">Give</a>
      </li>
    </ul>

    <button class="hamburger lg:hidden bg-none border-none cursor-pointer w-10 h-10 flex flex-col justify-center gap-[5px]" id="hamburger" aria-label="Menu">
      <span class="block w-6 h-0.5 bg-navy rounded-sm transition-all duration-300"></span>
      <span class="block w-6 h-0.5 bg-navy rounded-sm transition-all duration-300"></span>
      <span class="block w-6 h-0.5 bg-navy rounded-sm transition-all duration-300"></span>
    </button>
  </div>
</nav>

<div class="hidden fixed top-[72px] lg:top-20 left-0 right-0 bottom-0 bg-white/98 backdrop-blur-lg p-8 z-40 overflow-y-auto" id="mobileMenu">
  <div class="flex flex-col gap-1">
    {['About', 'Beliefs', 'Sermons', 'Ministries', 'Events', 'Gallery', 'Visit', 'Prayer', 'Give'].map(item => (
      <a href={'#' + (item === 'Prayer' ? 'prayer' : item === 'Give' ? 'contact' : item.toLowerCase())} class="mobile-link py-3.5 px-4 text-text no-underline text-[16px] font-medium rounded-lg hover:bg-surface transition-colors duration-200">
        {item}
      </a>
    ))}
  </div>
</div>

<style is:global>
  nav.scrolled { box-shadow: 0 4px 24px rgba(0,0,0,0.06); }
  .nav-link.active { color: var(--color-navy); background: var(--color-surface); }
</style>
