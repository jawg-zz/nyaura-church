---
// Newsletter
---

<section class="px-6 lg:px-12 py-20 bg-surface border-t border-border">
  <div class="max-w-[700px] mx-auto text-center reveal">
    <h3 class="text-[28px] mb-3">Stay Connected</h3>
    <p class="text-text-secondary text-sm mb-7 max-w-[480px] mx-auto">Get weekly announcements, sermon notes, and a Friday devotional delivered to your inbox.</p>
    <form class="flex gap-3 max-w-[460px] mx-auto" id="newsletterForm" action="https://formsubmit.co/newsletter@nyaurachurch.org" method="POST">
      <input type="hidden" name="_subject" value="New Newsletter Subscription">
      <input type="email" placeholder="Your email address" required name="email" class="flex-1 min-w-0 px-5 py-3.5 border border-border rounded-lg text-sm font-body transition-all duration-200 focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/10">
      <button type="submit" class="btn btn-primary btn-sm whitespace-nowrap">Subscribe</button>
    </form>
  </div>
</section>
